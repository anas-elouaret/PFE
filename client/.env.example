# API base URL — the backend server origin (without /api).
# The /api prefix is appended automatically by the API client.
# Dev: http://localhost:5000
# Production: https://api.yourdomain.com
VITE_API_URL=http://localhost:5000

# Web3Forms — sends the new order notification to growstackagency@gmail.com
# 1) Create a free account at https://web3forms.com (use growstackagency@gmail.com)
# 2) Dashboard → Access Key → copy it below
# 3) Restart `npm run dev` after editing this file.
# VITE_WEB3FORMS_ACCESS_KEY=your-access-key-here